From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zero Liu <zerolxy@gmail.com>
Date: Sat, 10 Oct 2026 12:13:52 -0700
Subject: [PATCH 1/2] Launch the bundled native Codex CLI directly on Windows

Spawning codex-acp cli through cmd.exe breaks when the relocated package path
contains spaces.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/CodexCli.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/CodexCli.ts b/src/CodexCli.ts
index 4998ed1..9f55332 100644
--- a/src/CodexCli.ts
+++ b/src/CodexCli.ts
@@ -24,7 +24,7 @@ function spawnCodexCli(codexPath: string | undefined, args: Array<string>): Chil
     };
 
     if (codexPath) {
-        return spawn(codexPath, args, {...options, shell: process.platform === "win32"});
+        return spawn(codexPath, args, {...options, shell: false});
     }
     const bundledCodexPath = createRequire(import.meta.url).resolve("@openai/codex/bin/codex.js");
     return spawn(process.execPath, [bundledCodexPath, ...args], options);
-- 
