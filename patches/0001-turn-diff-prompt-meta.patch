diff --git a/src/TurnDiffMeta.ts b/src/TurnDiffMeta.ts
new file mode 100644
index 0000000..00d103a
--- /dev/null
+++ b/src/TurnDiffMeta.ts
@@ -0,0 +1,31 @@
+import type {ClientCapabilities} from "@agentclientprotocol/sdk";
+import {isRecord} from "./permissions/json";
+
+export const CODEX_META_KEY = "codex";
+export const TURN_DIFF_META_KEY = "turnDiff";
+
+export type TurnDiffMeta =
+    | {status: "reported"; turnId: string; root: string; diff: string}
+    | {status: "unavailable"; turnId: string; reason: "tooLarge"};
+
+/** A client opts in with `initialize.clientCapabilities._meta.codex.turnDiff: true`. See `docs/turn-diff.md`. */
+export function clientSupportsTurnDiff(capabilities: ClientCapabilities | null | undefined): boolean {
+    const meta = capabilities?._meta;
+    const codex = isRecord(meta) ? meta[CODEX_META_KEY] : undefined;
+    return isRecord(codex) && codex[TURN_DIFF_META_KEY] === true;
+}
+
+export function createTurnDiffMeta(
+    turnId: string,
+    root: string,
+    diff: string,
+    oversized: boolean,
+): {[CODEX_META_KEY]: {[TURN_DIFF_META_KEY]: TurnDiffMeta}} {
+    return {
+        [CODEX_META_KEY]: {
+            [TURN_DIFF_META_KEY]: oversized
+                ? {status: "unavailable", turnId, reason: "tooLarge"}
+                : {status: "reported", turnId, root, diff},
+        },
+    };
+}
diff --git a/src/__tests__/CodexACPAgent/turn-diff-meta.test.ts b/src/__tests__/CodexACPAgent/turn-diff-meta.test.ts
new file mode 100644
index 0000000..bfd8096
--- /dev/null
+++ b/src/__tests__/CodexACPAgent/turn-diff-meta.test.ts
@@ -0,0 +1,136 @@
+import {beforeEach, describe, expect, it, vi} from "vitest";
+import * as acp from "@agentclientprotocol/sdk";
+import {
+    createCodexMockTestFixture,
+    createTestSessionState,
+    type CodexMockTestFixture,
+} from "../acp-test-utils";
+import type {SessionState} from "../../CodexAcpServer";
+import type {Turn} from "../../app-server/v2";
+import {AGENT_FILE_CHANGE_REPORT_MAX_DIFF_BYTES} from "../../AgentFileChangeReport";
+import {clientSupportsTurnDiff} from "../../TurnDiffMeta";
+
+const MAIN_DIFF = "diff --git a/notes/a.md b/notes/a.md\n--- a/notes/a.md\n+++ b/notes/a.md\n@@ -1 +1 @@\n-old\n+new\n";
+
+function createTurn(id: string, status: Turn["status"]): Turn {
+    return {
+        id,
+        rootTurnId: null,
+        items: [],
+        itemsView: "notLoaded",
+        status,
+        error: null,
+        startedAt: null,
+        completedAt: null,
+        durationMs: null,
+    };
+}
+
+async function setupPrompt(clientCapabilities?: acp.ClientCapabilities): Promise<{
+    fixture: CodexMockTestFixture;
+    sessionState: SessionState;
+    emitDiffBeforeCompletion: (diff: string) => void;
+}> {
+    const fixture = createCodexMockTestFixture();
+    await fixture.getCodexAcpAgent().initialize({
+        protocolVersion: acp.PROTOCOL_VERSION,
+        ...(clientCapabilities ? {clientCapabilities} : {}),
+    });
+    const sessionState = createTestSessionState({cwd: "/vault"});
+    vi.spyOn(fixture.getCodexAcpAgent(), "getSessionState").mockReturnValue(sessionState);
+    vi.spyOn(fixture.getCodexAppServerClient(), "turnStart")
+        .mockResolvedValue({turn: createTurn("main-turn", "inProgress")});
+    const awaitTurnCompleted = vi.spyOn(fixture.getCodexAppServerClient(), "awaitTurnCompleted")
+        .mockResolvedValue({threadId: sessionState.sessionId, turn: createTurn("main-turn", "completed")});
+    const emitDiffBeforeCompletion = (diff: string) => {
+        awaitTurnCompleted.mockImplementationOnce(async () => {
+            fixture.sendServerNotification({
+                method: "turn/diff/updated",
+                params: {threadId: sessionState.sessionId, turnId: "main-turn", diff},
+            });
+            return {threadId: sessionState.sessionId, turn: createTurn("main-turn", "completed")};
+        });
+    };
+    return {fixture, sessionState, emitDiffBeforeCompletion};
+}
+
+function prompt(sessionId: string): acp.PromptRequest {
+    return {sessionId, prompt: [{type: "text", text: "edit the note"}]};
+}
+
+const TURN_DIFF_CLIENT: acp.ClientCapabilities = {_meta: {codex: {turnDiff: true}}};
+
+describe("turn diff on the prompt response", () => {
+    beforeEach(() => {
+        vi.clearAllMocks();
+    });
+
+    it("returns Codex's final turn diff when the client opts in", async () => {
+        const {fixture, sessionState, emitDiffBeforeCompletion} = await setupPrompt(TURN_DIFF_CLIENT);
+        emitDiffBeforeCompletion(MAIN_DIFF);
+
+        const response = await fixture.getCodexAcpAgent().prompt(prompt(sessionState.sessionId));
+
+        expect(response).toMatchObject({
+            stopReason: "end_turn",
+            _meta: {
+                quota: expect.any(Object),
+                codex: {turnDiff: {status: "reported", turnId: "main-turn", root: "/vault", diff: MAIN_DIFF}},
+            },
+        });
+    });
+
+    it("reports an empty diff when the turn changed no files", async () => {
+        const {fixture, sessionState} = await setupPrompt(TURN_DIFF_CLIENT);
+
+        const response = await fixture.getCodexAcpAgent().prompt(prompt(sessionState.sessionId));
+
+        expect(response._meta).toMatchObject({
+            codex: {turnDiff: {status: "reported", turnId: "main-turn", diff: ""}},
+        });
+    });
+
+    it("reports tooLarge instead of sending a diff over the size limit", async () => {
+        const {fixture, sessionState, emitDiffBeforeCompletion} = await setupPrompt(TURN_DIFF_CLIENT);
+        emitDiffBeforeCompletion("x".repeat(AGENT_FILE_CHANGE_REPORT_MAX_DIFF_BYTES + 1));
+
+        const response = await fixture.getCodexAcpAgent().prompt(prompt(sessionState.sessionId));
+
+        expect(response._meta).toMatchObject({
+            codex: {turnDiff: {status: "unavailable", turnId: "main-turn", reason: "tooLarge"}},
+        });
+    });
+
+    it("leaves the prompt response unchanged for a client that did not opt in", async () => {
+        const {fixture, sessionState, emitDiffBeforeCompletion} = await setupPrompt();
+        emitDiffBeforeCompletion(MAIN_DIFF);
+
+        const response = await fixture.getCodexAcpAgent().prompt(prompt(sessionState.sessionId));
+
+        expect(response._meta).not.toHaveProperty("codex");
+    });
+
+    it("sends no diff for a cancelled prompt", async () => {
+        const {fixture, sessionState} = await setupPrompt(TURN_DIFF_CLIENT);
+        const cancellation = new AbortController();
+        cancellation.abort();
+
+        const response = await fixture.getCodexAcpAgent().prompt(
+            prompt(sessionState.sessionId),
+            cancellation.signal,
+        );
+
+        expect(response.stopReason).toBe("cancelled");
+        expect(response._meta ?? {}).not.toHaveProperty("codex");
+    });
+});
+
+describe("clientSupportsTurnDiff", () => {
+    it("accepts only an explicit true opt-in", () => {
+        expect(clientSupportsTurnDiff(TURN_DIFF_CLIENT)).toBe(true);
+        expect(clientSupportsTurnDiff({_meta: {codex: {turnDiff: "yes"}}})).toBe(false);
+        expect(clientSupportsTurnDiff({_meta: {codex: true}})).toBe(false);
+        expect(clientSupportsTurnDiff({})).toBe(false);
+        expect(clientSupportsTurnDiff(null)).toBe(false);
+    });
+});
